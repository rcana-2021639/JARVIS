{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Lo que costo una llamada a la nube. Viaja en `cognition.cost.updated`.",
  "properties": {
    "budget_exhausted": {
      "description": "Si con esta llamada se agoto el dia.",
      "title": "Budget Exhausted",
      "type": "boolean"
    },
    "budget_today_usd": {
      "description": "Tope diario. Cero es sin limite.",
      "minimum": 0.0,
      "title": "Budget Today Usd",
      "type": "number"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "cost_usd": {
      "description": "Costo de esta llamada.",
      "minimum": 0.0,
      "title": "Cost Usd",
      "type": "number"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "spent_today_usd": {
      "description": "Acumulado del dia, incluida esta.",
      "minimum": 0.0,
      "title": "Spent Today Usd",
      "type": "number"
    }
  },
  "required": [
    "model",
    "input_tokens",
    "output_tokens",
    "cost_usd",
    "spent_today_usd",
    "budget_today_usd",
    "budget_exhausted"
  ],
  "title": "CostUpdate",
  "type": "object"
}
